{
  "name": "city-top-pos",
  "version": "1.0.0",
  "description": "City Top POS - A simple point-of-sale API for managing orders and menu items",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "watch": "ts-node --transpile-only src/index.ts"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "express",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18"
  }
}
